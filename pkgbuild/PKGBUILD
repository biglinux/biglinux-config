# Maintainer: Rafael Ruscher <rruscher@gmail.com>
# Maintainer: Bruno Gonçalves <bigbruno@gmail.com>

pkgname=biglinux-config
# Earlier builds used date versions (2026_10_02); the epoch makes 2.0.0 newer.
epoch=1
pkgver=2.0.0
pkgrel=1
pkgdesc="Back up, restore and reset application settings (GTK 4/libadwaita)"
arch=('any')
url="https://github.com/ruscher/biglinux-config"
license=('GPL-3.0-or-later')
depends=(
  'dconf'
  'glib2'
  'gtk4>=1:4.12'
  'hicolor-icon-theme'
  'libadwaita>=1:1.6'
  'pango'
  'python>=3.12'
  'python-gobject'
)
makedepends=('git')
checkdepends=('python-pytest')
optdepends=('flatpak: back up and reset Flatpak application settings')
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

check() {
  cd "$pkgname"
  bash tools/check.sh
}

package() {
  cd "$pkgname/$pkgname"
  cp -a --no-preserve=ownership usr "$pkgdir/"

  local appdir=/usr/share/biglinux/biglinux-config
  python -m compileall -q -d "$appdir" "$pkgdir$appdir"
}
