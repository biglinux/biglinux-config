#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:45
#, python-format
msgid ""
"%s changed while the backup was being made. Close the application and try "
"again."
msgstr ""
"%s змяніўся падчас стварэння рэзервовай копіі. Закрыйце праграму і паўтарыце "
"спробу."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:52
msgid ""
"This file is damaged, incomplete or was not created by Restore Settings."
msgstr ""
"Гэты файл пашкоджаны, няпоўны або створаны не праграмай «Аднаўленне налад»."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:53
#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py:29
#, python-format
msgid "Details: %s"
msgstr "Падрабязнасці: %s"

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:170
#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:172
#, python-format
msgid "Could not save %s. Close the application and try again."
msgstr "Не ўдалося захаваць %s. Закрыйце праграму і паўтарыце спробу."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:174
#, python-format
msgid "The file name %r cannot be stored in a backup."
msgstr "Імя файла %r немагчыма захаваць у рэзервовай копіі."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:260
msgid "Choose a backup destination outside the selected applications' folders."
msgstr "Выберыце месца для рэзервовай копіі па-за папкамі выбраных праграм."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:604
#, python-format
msgid ""
"This backup contains settings for %s, which this version does not support. "
"Nothing was imported."
msgstr ""
"Гэта рэзервовая копія змяшчае налады праграмы %s, якія гэта версія не "
"падтрымлівае. Нічога не імпартавана."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:610
#, python-format
msgid ""
"This backup tries to write to %(path)s, which is not a settings folder of "
"%(app)s. Nothing was imported."
msgstr ""
"Гэта рэзервовая копія спрабуе запісаць даныя ў %(path)s, што не з’яўляецца "
"папкай налад праграмы %(app)s. Нічога не імпартавана."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:618
#, python-format
msgid ""
"This backup tries to change desktop settings (%(path)s) that do not belong "
"to %(app)s. Nothing was imported."
msgstr ""
"Гэта рэзервовая копія спрабуе змяніць налады працоўнага асяроддзя "
"(%(path)s), якія не належаць праграме %(app)s. Нічога не імпартавана."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:672
msgid "Select at least one application to restore."
msgstr "Выберыце прынамсі адну праграму для аднаўлення."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:682
msgid ""
"The dconf tool is needed to restore these desktop settings. Install the "
"dconf package."
msgstr ""
"Для аднаўлення гэтых налад працоўнага асяроддзя патрэбны інструмент dconf. "
"Усталюйце пакет dconf."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:686
#, python-format
msgid "Not enough free space: %(need)s needed, %(free)s available."
msgstr "Недастаткова вольнага месца: патрэбна %(need)s, даступна %(free)s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py:111
msgid "Could not check whether the Flatpak application is running."
msgstr "Не ўдалося праверыць, ці працуе праграма Flatpak."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py:250
msgid ""
"No BigLinux default settings are available for this application. Nothing was "
"reset."
msgstr ""
"Для гэтай праграмы няма прадвызначаных налад BigLinux. Нічога не скінута."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py:253
msgid ""
"A settings path is outside your home folder or protected. Nothing was reset."
msgstr ""
"Шлях да налад знаходзіцца па-за вашай хатняй папкай або абаронены. Нічога не "
"скінута."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py:267
msgid "Could not create a safety backup. Nothing was reset."
msgstr "Не ўдалося стварыць ахоўную рэзервовую копію. Нічога не скінута."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py:285
#, python-format
msgid "Could not reset the desktop settings in %s."
msgstr "Не ўдалося скінуць налады працоўнага асяроддзя ў %s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py:28
#, python-format
msgid "Automatic recovery did not finish. Your previous files are kept in %s."
msgstr ""
"Аўтаматычнае аднаўленне не завершана. Вашы папярэднія файлы захаваны ў %s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py:63
#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py:78
msgid ""
"Another backup, import or restore is already running. Wait for it to finish."
msgstr ""
"Ужо выконваецца іншае рэзервовае капіяванне, імпартаванне або аднаўленне. "
"Дачакайцеся яго завяршэння."

