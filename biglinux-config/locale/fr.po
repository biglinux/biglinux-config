#, python-format
msgid ""
"These settings are too large for one backup (%(size)s in %(count)d items). "
"Export fewer applications at a time."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:239
#, python-format
msgid ""
"%(count)d link points outside your home folder and was not included: "
"%(paths)s"
msgid_plural ""
"%(count)d links point outside your home folder and were not included: "
"%(paths)s"
msgstr[0] ""
msgstr[1] ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:255
#, python-format
msgid "The desktop settings in %s are too large to back up."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:321
msgid "Choose a backup destination outside the selected applications' folders."
msgstr ""
"Choisissez une destination de sauvegarde en dehors des dossiers des "
"applications sélectionnées."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:663
#, python-format
msgid ""
"This backup contains settings for %s, which this version does not support. "
"Nothing was imported."
msgstr ""
"Cette sauvegarde contient des paramètres pour %s que cette version ne prend "
"pas en charge. Rien n’a été importé."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:669
#, python-format
msgid ""
"This backup tries to write to %(path)s, which is not a settings folder of "
"%(app)s. Nothing was imported."
msgstr ""
"Cette sauvegarde tente d’écrire dans %(path)s, qui n’est pas un dossier de "
"paramètres de %(app)s. Rien n’a été importé."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:677
#, python-format
msgid ""
"This backup tries to change desktop settings (%(path)s) that do not belong "
"to %(app)s. Nothing was imported."
msgstr ""
"Cette sauvegarde tente de modifier des paramètres du bureau (%(path)s) qui "
"n’appartiennent pas à %(app)s. Rien n’a été importé."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:703
#, python-format
msgid "Could not change the desktop settings in %s."
msgstr ""

# File: biglinux-config/biglinux-config/usr/share/biglinux/biglinux-
# config/ui/backup_dialog.py, line: 89
#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:731
msgid "Select at least one application to restore."
msgstr "Sélectionnez au moins une application à restaurer."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:741
msgid ""
"The dconf tool is needed to restore these desktop settings. Install the "
"dconf package."
msgstr ""
"L’outil dconf est nécessaire pour restaurer ces paramètres du bureau. "
"Installez le paquet dconf."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:745
#, python-format
msgid "Not enough free space: %(need)s needed, %(free)s available."
msgstr "Espace libre insuffisant : %(need)s nécessaires, %(free)s disponibles."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py:112
msgid "Could not check whether the Flatpak application is running."
msgstr ""
"Impossible de vérifier si l’application Flatpak est en cours d’exécution."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py:193
#, python-format
msgid ""
"The BigLinux default contains %s, which cannot be copied safely. Nothing was "
