#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:255
#, python-format
msgid "The desktop settings in %s are too large to back up."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:321
msgid "Choose a backup destination outside the selected applications' folders."
msgstr "Выберите место для резервной копии вне папок выбранных приложений."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:663
#, python-format
msgid ""
"This backup contains settings for %s, which this version does not support. "
"Nothing was imported."
msgstr ""
"Эта резервная копия содержит настройки приложения %s, которые не "
"поддерживаются этой версией. Ничего не импортировано."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:669
#, python-format
msgid ""
"This backup tries to write to %(path)s, which is not a settings folder of "
"%(app)s. Nothing was imported."
msgstr ""
"Эта резервная копия пытается записать данные в %(path)s — папку, которая не "
"относится к настройкам приложения %(app)s. Ничего не импортировано."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:677
#, python-format
msgid ""
"This backup tries to change desktop settings (%(path)s) that do not belong "
"to %(app)s. Nothing was imported."
msgstr ""
"Эта резервная копия пытается изменить настройки рабочего окружения "
"(%(path)s), которые не относятся к приложению %(app)s. Ничего не "
"импортировано."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:703
#, python-format
msgid "Could not change the desktop settings in %s."
msgstr ""

