#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:44
#, python-format
msgid ""
"%s changed while the backup was being made. Close the application and try "
"again."
msgstr ""
"%s megváltozott a biztonsági mentés készítése közben. Zárja be az "
"alkalmazást, és próbálja újra."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:51
msgid ""
"This file is damaged, incomplete or was not created by Restore Settings."
msgstr ""
"Ez a fájl sérült, hiányos, vagy nem a Beállítások visszaállítása "
"alkalmazással készült."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:52
#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py:29
#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py:35
#, python-format
msgid "Details: %s"
msgstr "Részletek: %s"

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:182
#, python-format
msgid ""
"%s is protected or inside a folder that is a symbolic link. For safety, it "
"cannot be backed up."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:209
#, python-format
msgid "Could not save %s. Close the application and try again."
msgstr "Nem sikerült menteni: %s. Zárja be az alkalmazást, és próbálja újra."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:211
#, python-format
msgid "The file name %r cannot be stored in a backup."
msgstr "A(z) %r fájlnév nem tárolható biztonsági mentésben."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:225
#, python-format
msgid ""
"~/%(path)s is %(size)s; files larger than %(limit)s cannot be backed up."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:229
#, python-format
msgid ""
"These settings are too large for one backup (%(size)s in %(count)d items). "
"Export fewer applications at a time."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:239
#, python-format
msgid ""
"%(count)d link points outside your home folder and was not included: "
"%(paths)s"
msgid_plural ""
"%(count)d links point outside your home folder and were not included: "
"%(paths)s"
msgstr[0] ""
msgstr[1] ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:255
#, python-format
msgid "The desktop settings in %s are too large to back up."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:321
msgid "Choose a backup destination outside the selected applications' folders."
msgstr ""
"Válasszon a kijelölt alkalmazások mappáin kívüli célhelyet a biztonsági "
"mentéshez."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:663
#, python-format
msgid ""
"This backup contains settings for %s, which this version does not support. "
"Nothing was imported."
msgstr ""
"Ez a biztonsági mentés a(z) %s beállításait tartalmazza, amelyeket ez a "
"verzió nem támogat. Semmi sem lett importálva."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:669
#, python-format
msgid ""
"This backup tries to write to %(path)s, which is not a settings folder of "
"%(app)s. Nothing was imported."
msgstr ""
"Ez a biztonsági mentés a(z) %(path)s helyre próbál írni, amely nem a(z) "
"%(app)s beállításmappája. Semmi sem lett importálva."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:677
#, python-format
msgid ""
"This backup tries to change desktop settings (%(path)s) that do not belong "
"to %(app)s. Nothing was imported."
msgstr ""
"Ez a biztonsági mentés olyan asztali beállításokat (%(path)s) próbál "
"módosítani, amelyek nem tartoznak a(z) %(app)s alkalmazáshoz. Semmi sem lett "
"importálva."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:703
#, python-format
msgid "Could not change the desktop settings in %s."
msgstr ""

# File: biglinux-config/biglinux-config/usr/share/biglinux/biglinux-
# config/ui/backup_dialog.py, line: 89
#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:731
msgid "Select at least one application to restore."
msgstr "Válasszon ki legalább egy visszaállítandó alkalmazást."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:741
msgid ""
"The dconf tool is needed to restore these desktop settings. Install the "
"dconf package."
msgstr ""
"Ezeknek az asztali beállításoknak a visszaállításához a dconf eszköz "
"szükséges. Telepítse a dconf csomagot."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:745
#, python-format
msgid "Not enough free space: %(need)s needed, %(free)s available."
msgstr "Nincs elég szabad hely: szükséges: %(need)s, elérhető: %(free)s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py:112
msgid "Could not check whether the Flatpak application is running."
msgstr "Nem sikerült ellenőrizni, hogy fut-e a Flatpak-alkalmazás."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py:193
#, python-format
msgid ""
"The BigLinux default contains %s, which cannot be copied safely. Nothing was "
"reset."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py:252
msgid ""
"No BigLinux default settings are available for this application. Nothing was "
"reset."
msgstr ""
"Ehhez az alkalmazáshoz nem érhetők el BigLinux-alapbeállítások. Semmi sem "
"lett visszaállítva alaphelyzetbe."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py:255
msgid ""
"A settings path is outside your home folder or protected. Nothing was reset."
msgstr ""
"Az egyik beállítási útvonal a saját mappáján kívül található vagy védett. "
"Semmi sem lett visszaállítva alaphelyzetbe."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py:269
msgid "Could not create a safety backup. Nothing was reset."
msgstr ""
"Nem sikerült biztonsági mentést készíteni. Semmi sem lett visszaállítva "
"alaphelyzetbe."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py:287
#, python-format
msgid "Could not reset the desktop settings in %s."
msgstr "Nem sikerült alaphelyzetbe állítani az asztali beállításokat itt: %s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py:28
#, python-format
msgid "Automatic recovery did not finish. Your previous files are kept in %s."
msgstr ""
"Az automatikus helyreállítás nem fejeződött be. Korábbi fájljai itt maradtak "
"meg: %s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py:34
#, python-format
msgid ""
"The operation finished, but its temporary files could not be removed from %s."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py:69
#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py:84
msgid ""
"Another backup, import or restore is already running. Wait for it to finish."
msgstr ""
"Már folyamatban van egy másik biztonsági mentés, importálás vagy "
"visszaállítás. Várja meg a befejezését."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py:80
#, python-format
msgid "The operation lock file %s is not a private regular file."
msgstr ""

