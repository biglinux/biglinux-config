#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"%s changed while the backup was being made. Close the application and try "
"again."
msgstr "%s muutus varukoopia loomise ajal. Sulge rakendus ja proovi uuesti."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
msgid ""
"This file is damaged, incomplete or was not created by Restore Settings."
msgstr ""
"See fail on kahjustatud, puudulik või pole loodud rakendusega „Taasta "
"seaded“."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py
#, python-format
msgid "Details: %s"
msgstr "Üksikasjad: %s"

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"%s is protected or inside a folder that is a symbolic link. For safety, it "
"cannot be backed up."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid "Could not save %s. Close the application and try again."
msgstr "Faili %s ei saanud salvestada. Sulge rakendus ja proovi uuesti."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid "The file name %r cannot be stored in a backup."
msgstr "Failinime %r ei saa varukoopiasse salvestada."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"~/%(path)s is %(size)s; files larger than %(limit)s cannot be backed up."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"These settings are too large for one backup (%(size)s in %(count)d items). "
"Export fewer applications at a time."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"%(count)d link points outside your home folder and was not included: "
"%(paths)s"
msgid_plural ""
"%(count)d links point outside your home folder and were not included: "
"%(paths)s"
msgstr[0] ""
msgstr[1] ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid "The desktop settings in %s are too large to back up."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
msgid "Choose a backup destination outside the selected applications' folders."
msgstr "Vali varukoopia sihtkoht väljaspool valitud rakenduste kaustu."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"This backup contains settings for %s, which this version does not support. "
"Nothing was imported."
msgstr ""
"See varukoopia sisaldab rakenduse %s seadeid, mida see versioon ei toeta. "
"Midagi ei imporditud."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"This backup tries to write to %(path)s, which is not a settings folder of "
"%(app)s. Nothing was imported."
msgstr ""
"See varukoopia püüab kirjutada asukohta %(path)s, mis pole rakenduse %(app)s "
"seadete kaust. Midagi ei imporditud."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"This backup tries to change desktop settings (%(path)s) that do not belong "
"to %(app)s. Nothing was imported."
msgstr ""
"See varukoopia püüab muuta töölaua seadeid (%(path)s), mis ei kuulu "
"rakendusele %(app)s. Midagi ei imporditud."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid "Could not change the desktop settings in %s."
msgstr ""

# File: biglinux-config/biglinux-config/usr/share/biglinux/biglinux-
# config/ui/backup_dialog.py, line: 89
#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
msgid "Select at least one application to restore."
msgstr "Vali taastamiseks vähemalt üks rakendus."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
msgid ""
"The dconf tool is needed to restore these desktop settings. Install the "
"dconf package."
msgstr ""
"Nende töölaua seadete taastamiseks on vaja tööriista dconf. Paigalda pakett "
"dconf."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid "Not enough free space: %(need)s needed, %(free)s available."
msgstr "Vaba ruumi ei ole piisavalt: vaja on %(need)s, saadaval on %(free)s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py
msgid "Could not check whether the Flatpak application is running."
msgstr "Ei saanud kontrollida, kas Flatpaki rakendus töötab."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py
#, python-format
msgid ""
"The BigLinux default contains %s, which cannot be copied safely. Nothing was "
"reset."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py
msgid ""
"No BigLinux default settings are available for this application. Nothing was "
"reset."
msgstr ""
"Selle rakenduse jaoks pole BigLinuxi vaikeseadeid saadaval. Midagi ei "
"lähtestatud."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py
msgid ""
"A settings path is outside your home folder or protected. Nothing was reset."
msgstr ""
"Seadete asukoht on väljaspool kodukausta või on kaitstud. Midagi ei "
"lähtestatud."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py
msgid "Could not create a safety backup. Nothing was reset."
msgstr "Turvavarukoopiat ei saanud luua. Midagi ei lähtestatud."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py
#, python-format
msgid "Could not reset the desktop settings in %s."
msgstr "Töölaua seadeid asukohas %s ei saanud lähtestada."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py
#, python-format
msgid "Automatic recovery did not finish. Your previous files are kept in %s."
msgstr ""
"Automaatne taastamine ei jõudnud lõpule. Sinu varasemad failid on alles "
"asukohas %s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py
#, python-format
msgid ""
"The operation finished, but its temporary files could not be removed from %s."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py
msgid ""
"Another backup, import or restore is already running. Wait for it to finish."
msgstr ""
"Teine varundamine, importimine või taastamine on juba pooleli. Oota, kuni "
"see lõpeb."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py
#, python-format
msgid "The operation lock file %s is not a private regular file."
msgstr ""

