#, python-format
msgid "The desktop settings in %s are too large to back up."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
msgid "Choose a backup destination outside the selected applications' folders."
msgstr ""
"Alegeți o destinație pentru copia de siguranță în afara dosarelor "
"aplicațiilor selectate."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"This backup contains settings for %s, which this version does not support. "
"Nothing was imported."
msgstr ""
"Această copie de siguranță conține setări pentru %s, pe care această "
"versiune nu le acceptă. Nu s-a importat nimic."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"This backup tries to write to %(path)s, which is not a settings folder of "
"%(app)s. Nothing was imported."
msgstr ""
"Această copie de siguranță încearcă să scrie în %(path)s, care nu este un "
"dosar de setări al aplicației %(app)s. Nu s-a importat nimic."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"This backup tries to change desktop settings (%(path)s) that do not belong "
"to %(app)s. Nothing was imported."
msgstr ""
"Această copie de siguranță încearcă să modifice setări ale mediului desktop "
"(%(path)s) care nu aparțin aplicației %(app)s. Nu s-a importat nimic."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid "Could not change the desktop settings in %s."
msgstr ""

