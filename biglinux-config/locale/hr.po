#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:44
#, python-format
msgid ""
"%s changed while the backup was being made. Close the application and try "
"again."
msgstr ""
"%s je promijenjen tijekom izrade sigurnosne kopije. Zatvorite aplikaciju i "
"pokušajte ponovno."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:51
msgid ""
"This file is damaged, incomplete or was not created by Restore Settings."
msgstr ""
"Ova je datoteka oštećena, nepotpuna ili nije izrađena aplikacijom Vraćanje "
"postavki."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:52
#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py:29
#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py:35
#, python-format
msgid "Details: %s"
msgstr "Pojedinosti: %s"

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:182
#, python-format
msgid ""
"%s is protected or inside a folder that is a symbolic link. For safety, it "
"cannot be backed up."
msgstr ""

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py:209
#, python-format
msgid "Could not save %s. Close the application and try again."
msgstr "Nije moguće spremiti %s. Zatvorite aplikaciju i pokušajte ponovno."

