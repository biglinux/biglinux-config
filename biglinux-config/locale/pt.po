#, python-format
msgid ""
"%s changed while the backup was being made. Close the application and try "
"again."
msgstr ""
"%s foi alterado durante o backup. Feche o aplicativo e tente novamente."

msgid ""
"This file is damaged, incomplete or was not created by Restore Settings."
msgstr ""
"Este arquivo está danificado, incompleto ou não foi criado pelo Restaurar "
"Configurações."

#, python-format
msgid "Details: %s"
msgstr "Detalhes: %s"

#, python-format
msgid "Could not save %s. Close the application and try again."
msgstr "Não foi possível salvar %s. Feche o aplicativo e tente novamente."

#, python-format
msgid "The file name %r cannot be stored in a backup."
msgstr "O nome de arquivo %r não pode ser guardado em um backup."

msgid ""
"Choose a backup destination outside the selected applications' folders."
msgstr ""
"Escolha um destino para o backup fora das pastas dos aplicativos "
"selecionados."

#, python-format
msgid ""
"This backup contains settings for %s, which this version does not support. "
"Nothing was imported."
msgstr ""
"Este backup contém configurações de %s, que esta versão não suporta. Nada "
"foi importado."

#, python-format
msgid ""
"This backup tries to write to %(path)s, which is not a settings folder of "
"%(app)s. Nothing was imported."
msgstr ""
"Este backup tenta gravar em %(path)s, que não é uma pasta de configurações "
"de %(app)s. Nada foi importado."

#, python-format
msgid ""
"This backup tries to change desktop settings (%(path)s) that do not belong "
"to %(app)s. Nothing was imported."
msgstr ""
"Este backup tenta alterar configurações da área de trabalho (%(path)s) que "
"não pertencem a %(app)s. Nada foi importado."

msgid "Select at least one application to restore."
msgstr "Selecione pelo menos um aplicativo para restaurar."

msgid ""
"The dconf tool is needed to restore these desktop settings. Install the "
"dconf package."
msgstr ""
"A ferramenta dconf é necessária para restaurar estas configurações da área "
"de trabalho. Instale o pacote dconf."

#, python-format
msgid "Not enough free space: %(need)s needed, %(free)s available."
msgstr ""
"Espaço livre insuficiente: são necessários %(need)s, há %(free)s "
"disponíveis."

msgid "Could not check whether the Flatpak application is running."
msgstr "Não foi possível verificar se o aplicativo Flatpak está em execução."

msgid ""
"No BigLinux default settings are available for this application. Nothing was"
" reset."
msgstr ""
"Não há configurações padrão do BigLinux para este aplicativo. Nada foi "
"redefinido."

msgid ""
"A settings path is outside your home folder or protected. Nothing was reset."
msgstr ""
"Um caminho de configuração está fora da sua pasta pessoal ou é protegido. "
"Nada foi redefinido."

msgid "Could not create a safety backup. Nothing was reset."
msgstr "Não foi possível criar o backup de segurança. Nada foi redefinido."

#, python-format
msgid "Could not reset the desktop settings in %s."
msgstr ""
"Não foi possível redefinir as configurações da área de trabalho em %s."

#, python-format
msgid "Automatic recovery did not finish. Your previous files are kept in %s."
msgstr ""
"A recuperação automática não terminou. Seus arquivos anteriores foram "
"mantidos em %s."

msgid ""
"Another backup, import or restore is already running. Wait for it to finish."
msgstr ""
"Outro backup, importação ou restauração já está em andamento. Aguarde a "
"conclusão."

