#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"%s changed while the backup was being made. Close the application and try "
"again."
msgstr ""
"%s foi alterado durante a criação da cópia de segurança. Feche a aplicação e "
"tente novamente."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
msgid ""
"This file is damaged, incomplete or was not created by Restore Settings."
msgstr ""
"Este ficheiro está danificado, incompleto ou não foi criado pelo Restaurar "
"definições."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py
#, python-format
msgid "Details: %s"
msgstr "Detalhes: %s"

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"%s is protected or inside a folder that is a symbolic link. For safety, it "
"cannot be backed up."
msgstr ""
"%s está protegido ou dentro de uma pasta que é uma ligação simbólica. Por "
"segurança, não é possível fazer cópia de segurança."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid "Could not save %s. Close the application and try again."
msgstr "Não foi possível guardar %s. Feche a aplicação e tente novamente."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid "The file name %r cannot be stored in a backup."
msgstr "O nome de ficheiro %r não pode ser guardado numa cópia de segurança."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"~/%(path)s is %(size)s; files larger than %(limit)s cannot be backed up."
msgstr ""
"~/%(path)s tem %(size)s; não é possível guardar ficheiros maiores que "
"%(limit)s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"These settings are too large for one backup (%(size)s in %(count)d items). "
"Export fewer applications at a time."
msgstr ""
"Estas definições são demasiado grandes para uma única cópia de segurança "
"(%(size)s em %(count)d itens). Exporte menos aplicações de cada vez."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"%(count)d link points outside your home folder and was not included: "
"%(paths)s"
msgid_plural ""
"%(count)d links point outside your home folder and were not included: "
"%(paths)s"
msgstr[0] ""
"%(count)d ligação aponta para fora da sua pasta pessoal e não foi incluída: "
"%(paths)s"
msgstr[1] ""
"%(count)d ligações apontam para fora da sua pasta pessoal e não foram "
"incluídas: %(paths)s"

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid "The desktop settings in %s are too large to back up."
msgstr ""
"As definições do ambiente de trabalho em %s são demasiado grandes para a "
"cópia de segurança."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
msgid "Choose a backup destination outside the selected applications' folders."
msgstr ""
"Escolha um destino para a cópia de segurança fora das pastas das aplicações "
"selecionadas."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"This backup contains settings for %s, which this version does not support. "
"Nothing was imported."
msgstr ""
"Esta cópia de segurança contém definições de %s que esta versão não suporta. "
"Nada foi importado."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"This backup tries to write to %(path)s, which is not a settings folder of "
"%(app)s. Nothing was imported."
msgstr ""
"Esta cópia de segurança tenta escrever em %(path)s, que não é uma pasta de "
"definições de %(app)s. Nada foi importado."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid ""
"This backup tries to change desktop settings (%(path)s) that do not belong "
"to %(app)s. Nothing was imported."
msgstr ""
"Esta cópia de segurança tenta alterar definições do ambiente de trabalho "
"(%(path)s) que não pertencem a %(app)s. Nada foi importado."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid "Could not change the desktop settings in %s."
msgstr "Não foi possível alterar as definições do ambiente de trabalho em %s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
msgid "Select at least one application to restore."
msgstr "Selecione pelo menos uma aplicação para restaurar."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
msgid ""
"The dconf tool is needed to restore these desktop settings. Install the "
"dconf package."
msgstr ""
"A ferramenta dconf é necessária para restaurar estas definições do ambiente "
"de trabalho. Instale o pacote dconf."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/backup_manager.py
#, python-format
msgid "Not enough free space: %(need)s needed, %(free)s available."
msgstr ""
"Espaço livre insuficiente: são necessários %(need)s e estão disponíveis "
"%(free)s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py
msgid "Could not check whether the Flatpak application is running."
msgstr "Não foi possível verificar se a aplicação Flatpak está em execução."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py
#, python-format
msgid ""
"The BigLinux default contains %s, which cannot be copied safely. Nothing was "
"reset."
msgstr ""
"O padrão do BigLinux contém %s, que não pode ser copiado com segurança. Nada "
"foi reposto."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py
msgid ""
"No BigLinux default settings are available for this application. Nothing was "
"reset."
msgstr ""
"Não existem predefinições do BigLinux para esta aplicação. Nada foi reposto."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py
msgid ""
"A settings path is outside your home folder or protected. Nothing was reset."
msgstr ""
"Um caminho de definições está fora da sua pasta pessoal ou está protegido. "
"Nada foi reposto."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py
msgid "Could not create a safety backup. Nothing was reset."
msgstr ""
"Não foi possível criar uma cópia de segurança preventiva. Nada foi reposto."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/reset_manager.py
#, python-format
msgid "Could not reset the desktop settings in %s."
msgstr "Não foi possível repor as definições do ambiente de trabalho em %s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py
#, python-format
msgid "Automatic recovery did not finish. Your previous files are kept in %s."
msgstr ""
"A recuperação automática não foi concluída. Os seus ficheiros anteriores "
"estão guardados em %s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py
#, python-format
msgid ""
"The operation finished, but its temporary files could not be removed from %s."
msgstr ""
"A operação terminou, mas os ficheiros temporários não puderam ser removidos "
"de %s."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py
msgid ""
"Another backup, import or restore is already running. Wait for it to finish."
msgstr ""
"Já está em curso outra operação de cópia de segurança, importação ou "
"restauro. Aguarde que termine."

#: biglinux-config/usr/share/biglinux/biglinux-config/backend/transactions.py
#, python-format
msgid "The operation lock file %s is not a private regular file."
msgstr ""
"O ficheiro de bloqueio de operações %s não é um ficheiro normal e privado."

